# Provider keys (read by LiteLLM)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Llama-3-8B served by vLLM on the Studio GPU (scripts/serve_llama.sh)
HOSTED_VLLM_API_BASE=http://localhost:8000/v1

# LangSmith tracing (picked up automatically by LangGraph)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=costcompose

# Optional: override caching.redis_url from the configs
# COSTCOMPOSE_REDIS_URL=redis://localhost:6379/0

# Hugging Face token with GAIA access (scripts/prepare_gaia.py)
HF_TOKEN=
