# Environment for a full run. The costcompose CLI does not load this file itself:
# export it (`set -a; . ./.env; set +a`) or use `docker compose`, which reads it via env_file.

# Provider keys (read by LiteLLM)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Llama-3.1-8B served by vLLM on the Studio GPU (scripts/serve_llama.sh), read by LiteLLM's
# hosted_vllm provider
HOSTED_VLLM_API_BASE=http://localhost:8000/v1

# LangSmith tracing (picked up automatically by LangGraph; the native engine is not traced).
# Off by default: tracing uploads every prompt and output, including GAIA tasks and your
# corpus, to LangSmith. Reported metrics come from the harness, not from traces.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=costcompose

# Optional: override caching.redis_url from the configs (read by costcompose.experiment)
# COSTCOMPOSE_REDIS_URL=redis://localhost:6379/0

# Hugging Face token with access to GAIA and Llama 3.1 (read by `datasets` in
# scripts/prepare_gaia.py and by vLLM when it downloads the model). Read-only is enough.
HF_TOKEN=

# Test-only: enables tests/test_redis.py against a live Redis (set in CI's "full" job)
# REDIS_URL=redis://localhost:6379/0

# Optional overrides for scripts/serve_llama.sh
# MODEL=meta-llama/Llama-3.1-8B-Instruct
# HOST=127.0.0.1
# CUDA_VISIBLE_DEVICES=0
# PORT=8000
